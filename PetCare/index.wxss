.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 30rpx 240rpx;
  background: #f8fcf9;
  color: #23342b;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.pet-main,
.section-head,
.sheet-actions,
.record,
.record-right {
  display: flex;
  align-items: center;
}

.pet-main,
.section-head,
.record {
  justify-content: space-between;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
}

.app-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding-top: env(safe-area-inset-top);
}

@supports (padding-top: constant(safe-area-inset-top)) {
  .app-nav {
    padding-top: constant(safe-area-inset-top);
  }
}

.app-nav-title {
  color: #2f7d5c;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.2;
}

.summary-head {
  margin-top: 18rpx;
}

.eyebrow {
  color: #7a8a81;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  margin-top: 16rpx;
  color: #24352d;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.08;
}

.icon-btn {
  border-radius: 50%;
  background: #ffffff;
  color: #2f7d5c;
  font-size: 42rpx;
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx #e1ece5;
}

.pet-tabs {
  margin: 42rpx -30rpx 30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.pet-tab {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  box-sizing: border-box;
  width: 218rpx;
  height: 96rpx;
  margin-right: 12rpx;
  padding: 12rpx 14rpx;
  border: 0;
  border-radius: 22rpx;
  background: #ffffff;
  color: #718176;
  font-size: 28rpx;
  text-align: left;
  vertical-align: top;
}

.pet-tab.active {
  background: #e7f6ee;
  color: #225f45;
  font-weight: 800;
  box-shadow: inset 0 0 0 2rpx #a9dbc1;
}

.pet-tab-avatar {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #edf5ef;
}

.pet-tab-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  line-height: 1.2;
}

.pet-tab-name {
  display: block;
  max-width: 120rpx;
  color: #23342b;
  font-size: 27rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-tab-type {
  display: block;
  margin-top: 6rpx;
  color: #7a8a81;
  font-size: 21rpx;
  font-weight: 800;
}

.pet-emoji,
.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #2f8f68;
  color: #ffffff;
  font-weight: 900;
}

.pet-emoji {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.pet-panel,
.empty-panel {
  background: transparent;
}

.pet-main,
.empty-panel {
  border-radius: 16rpx;
  background: #ffffff;
  padding: 28rpx 30rpx;
  box-shadow: 0 16rpx 36rpx rgba(51, 85, 68, 0.08), inset 0 0 0 2rpx #e7efe9;
}

.pet-main-avatar {
  flex: 0 0 auto;
  width: 92rpx;
  height: 92rpx;
  margin-right: 18rpx;
  border-radius: 24rpx;
  background: #edf5ef;
}

.pet-main > view {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.pet-name {
  color: #23342b;
  font-size: 40rpx;
  font-weight: 900;
  text-align: left;
}

.pet-meta {
  margin-top: 10rpx;
  color: #6f7f75;
  font-size: 25rpx;
  text-align: left;
}

.ghost-btn,
.primary-btn,
.danger-btn {
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.ghost-btn {
  background: #eef5f0;
  color: #2f7d5c;
}

.primary-btn {
  background: #2f8f68;
  color: #ffffff;
}

.danger-btn {
  background: #fff1e8;
  color: #c2410c;
}

.pet-delete-btn {
  width: 100%;
  margin-top: 22rpx;
}

.section {
  margin-top: 48rpx;
}

.first-section {
  margin-top: 0;
}

.tab-page {
  margin-top: 30rpx;
}

.quick-entry {
  cursor: pointer;
}

.section-title {
  color: #23342b;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: left;
}

.section-head .section-title {
  text-align: left;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #6f7f75;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: left;
}

.stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.stat {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  min-height: 170rpx;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: left;
  overflow: hidden;
  box-shadow: 0 14rpx 30rpx rgba(51, 85, 68, 0.07), inset 0 0 0 2rpx #e7efe9;
}

.stat {
  justify-content: flex-start;
  min-height: 320rpx;
}

.stat-label {
  display: block;
  color: #6f7f75;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
}

.stat-num {
  display: inline-block;
  color: #2f8f68;
  font-size: 74rpx;
  font-weight: 900;
  line-height: 0.9;
}

.stat-value {
  display: flex;
  align-items: flex-end;
  margin-top: 22rpx;
  margin-bottom: 20rpx;
}

.stat-unit {
  display: inline-block;
  margin-left: 8rpx;
  color: #7f8c84;
  font-size: 24rpx;
  font-weight: 700;
}

.tone-1 .stat-num {
  color: #c89211;
}

.tone-2 .stat-num {
  color: #d97706;
}

.tone-3 .stat-num {
  color: #2477a8;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  margin-top: 12rpx;
  color: #7a8a81;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.stat-row text:last-child {
  min-width: 0;
  color: #2d3d34;
  text-align: right;
  word-break: break-all;
}

.stat.warn .stat-row:nth-of-type(3) text:last-child {
  color: #d97706;
}

.stat.soon .stat-row:nth-of-type(3) text:last-child {
  color: #c89211;
}

.detail-btn {
  box-sizing: border-box;
  align-self: center;
  width: 100%;
  max-width: 220rpx;
  min-width: 0;
  height: 56rpx;
  padding: 0;
  margin-top: 22rpx;
  border-radius: 16rpx;
  background: #fff5df;
  color: #b96f00;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
  line-height: 56rpx;
}

@media (max-width: 340px) {
  .stats {
    grid-template-columns: 1fr;
  }

  .stat {
    min-height: 280rpx;
  }

  .detail-btn {
    max-width: 260rpx;
  }
}

.quick-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 148rpx;
  margin-top: 24rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #2f8f68;
  font-size: 38rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 30rpx rgba(51, 85, 68, 0.07), inset 0 0 0 2rpx #dcebe2;
}

.health-page .section-head {
  align-items: flex-start;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #23342b;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: left;
}

.health-textarea {
  min-height: 260rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  box-shadow: inset 0 0 0 2rpx #dcebe2;
}

.health-upload-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.media-btn {
  height: 78rpx;
  border-radius: 16rpx;
  background: #eef7f1;
  color: #2f7d5c;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.media-item {
  min-width: 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx #e7efe9;
}

.media-preview {
  display: block;
  width: 100%;
  height: 210rpx;
  background: #edf5ef;
}

.media-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 14rpx;
  color: #6f7f75;
  font-size: 22rpx;
  font-weight: 800;
}

.media-meta text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-analyze-btn {
  width: 100%;
  height: 82rpx;
  margin-top: 22rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  line-height: 82rpx;
}

.health-note {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7df;
  color: #9f6b00;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
  text-align: left;
}

.health-result {
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(51, 85, 68, 0.07), inset 0 0 0 2rpx #bde5cf;
}

.health-result.urgent {
  box-shadow: 0 14rpx 30rpx rgba(51, 85, 68, 0.07), inset 0 0 0 2rpx rgba(217, 119, 6, 0.42);
}

.health-status {
  display: inline-flex;
  max-width: 100%;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #e8f7ef;
  color: #2f7d5c;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
}

.health-result.urgent .health-status {
  background: #fff1e8;
  color: #c2410c;
}

.health-result-title {
  margin-top: 20rpx;
  color: #23342b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: left;
}

.health-paragraph,
.health-evidence,
.health-confidence,
.health-list-item,
.source-note,
.source-url {
  color: #4d5b53;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: left;
}

.health-paragraph {
  margin-top: 14rpx;
}

.health-evidence {
  margin-top: 14rpx;
  color: #718176;
}

.health-confidence {
  margin-top: 12rpx;
  color: #9f6b00;
  font-weight: 800;
}

.health-block {
  margin-top: 26rpx;
}

.health-block-title {
  margin-bottom: 12rpx;
  color: #2f8f68;
  font-size: 28rpx;
  font-weight: 900;
  text-align: left;
}

.health-list-item {
  position: relative;
  margin-top: 10rpx;
  padding-left: 24rpx;
}

.health-list-item::before {
  position: absolute;
  left: 0;
  top: 17rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #2f8f68;
  content: "";
}

.health-list-item.muted {
  color: #718176;
}

.health-list-item.muted::before {
  background: #9daaa1;
}

.source-item {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f4f8f5;
  text-align: left;
}

.source-title {
  color: #23342b;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.source-note {
  margin-top: 8rpx;
  color: #6f7f75;
}

.source-url {
  display: block;
  margin-top: 8rpx;
  color: #2477a8;
  word-break: break-all;
}

.quick-choice-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.type-choice-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.type-choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  gap: 10rpx;
  border-radius: 16rpx;
  background: #f1f7f3;
  color: #6f7f75;
  font-size: 24rpx;
  font-weight: 900;
}

.type-choice.selected {
  background: #2f8f68;
  color: #ffffff;
}

.type-choice.selected .quick-icon {
  background: #ffffff;
  color: #2f8f68;
}

.walk-fields {
  margin-top: -2rpx;
}

.walk-time-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.walk-time-grid .picker,
.walk-time-grid .input {
  margin-bottom: 0;
}

.unit-input {
  position: relative;
  min-width: 0;
}

.unit-input .input {
  padding-right: 82rpx;
}

.unit-input text {
  position: absolute;
  right: 18rpx;
  top: 50%;
  color: #6f7f75;
  font-size: 24rpx;
  font-weight: 900;
  transform: translateY(-50%);
}

.stool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.stool-choice {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 16rpx;
  background: #f1f7f3;
  color: #6f7f75;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.stool-choice.selected {
  background: #2f8f68;
  color: #ffffff;
}

.quick-choice {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  min-height: 116rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: left;
  box-shadow: inset 0 0 0 2rpx #e7efe9;
}

.quick-icon {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.quick-title {
  margin-top: 18rpx;
  color: #23342b;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.quick-choice .quick-title {
  margin-top: 0;
}

.quick-sub {
  margin-top: 8rpx;
  color: #718176;
  font-size: 22rpx;
  line-height: 1.35;
}

.reminders {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
}

.reminder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 82rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #4d5b53;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
}

.reminder text {
  flex: 1;
}

.reminder.warn {
  color: #d97706;
  background: #fff1e8;
}

.reminder.soon {
  color: #9f6b00;
  background: #fff7df;
}

.calendar-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(51, 85, 68, 0.06), inset 0 0 0 2rpx #e7efe9;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.calendar-title {
  box-sizing: border-box;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 270rpx;
  height: 52rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #fff8e6;
  color: #d97706;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: inset 0 0 0 2rpx #ffe4ad, 0 8rpx 18rpx rgba(217, 119, 6, 0.1);
}

.calendar-nav-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 82rpx;
  width: 82rpx;
  height: 52rpx;
  min-width: 0;
  padding: 0;
  border-radius: 18rpx;
  background: #eef7f1;
  color: #2f7d5c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
}

.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-weekdays {
  margin-top: 22rpx;
  color: #718176;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.calendar-grid {
  gap: 8rpx;
  margin-top: 12rpx;
}

.calendar-day {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  height: 88rpx;
  padding-top: 10rpx;
  border-radius: 16rpx;
  background: #f7fbf8;
  color: #23342b;
  font-size: 25rpx;
  font-weight: 900;
}

.calendar-day.muted {
  color: #b1beb6;
  background: #fbfdfb;
}

.calendar-day.today {
  box-shadow: inset 0 0 0 2rpx #bde5cf;
}

.calendar-day.selected {
  background: #2f8f68;
  color: #ffffff;
}

.calendar-dots {
  display: flex;
  justify-content: center;
  gap: 4rpx;
  width: 100%;
  min-height: 12rpx;
  margin-top: 10rpx;
}

.calendar-dot {
  display: inline-block;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #9daaa1;
}

.calendar-dot.green {
  background: #2f8f68;
}

.calendar-dot.blue {
  background: #2477a8;
}

.calendar-dot.amber {
  background: #c89211;
}

.calendar-dot.orange {
  background: #d97706;
}

.calendar-day.selected .calendar-dot {
  background: #ffffff;
}

.calendar-legend {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
  color: #718176;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.calendar-legend view {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  white-space: nowrap;
}

.day-records {
  margin-top: 28rpx;
}

.day-records-title {
  color: #23342b;
  font-size: 30rpx;
  font-weight: 900;
  text-align: left;
}

.record {
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(51, 85, 68, 0.06), inset 0 0 0 2rpx #e7efe9;
}

.record > view:first-child {
  flex: 1;
  text-align: left;
}

.record-title {
  color: #23342b;
  font-size: 30rpx;
  font-weight: 900;
}

.record-note,
.record-right,
.empty,
.empty-text {
  color: #718176;
  font-size: 24rpx;
}

.record-note {
  margin-top: 8rpx;
}

.record-right {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 158rpx;
  text-align: center;
}

.pet-list-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(51, 85, 68, 0.06), inset 0 0 0 2rpx #e7efe9;
}

.pet-list-item.active {
  box-shadow: 0 12rpx 28rpx rgba(51, 85, 68, 0.06), inset 0 0 0 2rpx rgba(47, 143, 104, 0.38);
}

.pet-list-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #e8f7ef;
  color: #2f7d5c;
  font-size: 24rpx;
  font-weight: 900;
}

.pet-list-body {
  flex: 1;
  min-width: 0;
}

.pet-list-name {
  color: #23342b;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.pet-list-meta {
  margin-top: 8rpx;
  color: #6f7f75;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-all;
}

.delete-btn {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #fff1e8;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 800;
}

.empty {
  margin-top: 20rpx;
  padding: 34rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
}

.empty-panel {
  margin-top: 36rpx;
  text-align: center;
}

.empty-title {
  color: #23342b;
  font-size: 38rpx;
  font-weight: 900;
}

.empty-text {
  margin: 16rpx 0 26rpx;
  text-align: center;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.72);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  padding: 36rpx 30rpx calc(56rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -20rpx 54rpx rgba(51, 85, 68, 0.18);
  overflow-y: auto;
}

@supports (bottom: constant(safe-area-inset-bottom)) {
  .sheet {
    padding-bottom: calc(56rpx + constant(safe-area-inset-bottom));
  }
}

.sheet-title {
  margin-bottom: 24rpx;
  color: #23342b;
  font-size: 36rpx;
  font-weight: 900;
  text-align: center;
}

.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: -4rpx auto 24rpx;
}

.avatar-preview {
  width: 142rpx;
  height: 142rpx;
  border-radius: 34rpx;
  background: #edf5ef;
  box-shadow: inset 0 0 0 2rpx #dcebe2;
}

.avatar-picker-text {
  margin-top: 12rpx;
  color: #2f8f68;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.drawer {
  padding-top: 18rpx;
}

.drawer-bar {
  width: 86rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #d7e5dc;
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.drawer-head .sheet-title {
  flex: 1;
  margin-bottom: 0;
  text-align: left;
}

.input,
.picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 16rpx;
  background: #f4f8f5;
  color: #23342b;
  font-size: 28rpx;
  text-align: center;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.3;
}

.form-label {
  margin: 8rpx 0 16rpx;
  color: #23342b;
  font-size: 27rpx;
  font-weight: 900;
  text-align: center;
}

.interval-grid,
.profile-grid,
.segmented {
  display: grid;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.interval-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.profile-grid,
.segmented {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.interval-field,
.profile-field {
  color: #6f7f75;
  font-size: 24rpx;
  text-align: center;
}

.interval-input,
.compact-picker,
.compact-input {
  min-height: 76rpx;
  margin: 8rpx 0 0;
  padding: 0 14rpx;
  font-size: 26rpx;
}

.due-preview {
  margin: -4rpx 0 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #e8f7ef;
  color: #2f7d5c;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.segmented button {
  height: 76rpx;
  border-radius: 16rpx;
  background: #f1f7f3;
  color: #6f7f75;
  font-size: 28rpx;
  font-weight: 800;
}

.segmented button.selected {
  background: #2f8f68;
  color: #ffffff;
}

.sheet-actions {
  justify-content: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.bottom-tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  box-sizing: border-box;
  padding: 14rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 34rpx rgba(51, 85, 68, 0.12), inset 0 0 0 2rpx #e7efe9;
}

@supports (bottom: constant(safe-area-inset-bottom)) {
  .bottom-tabs {
    padding-bottom: calc(18rpx + constant(safe-area-inset-bottom));
  }
}

.bottom-tab {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 76rpx;
  padding: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #718176;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.bottom-tab.active {
  background: #e8f7ef;
  color: #2f7d5c;
}

.bottom-tab text {
  display: block;
  width: 100%;
  text-align: center;
  white-space: nowrap;
}
