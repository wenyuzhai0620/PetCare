.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 30rpx 240rpx;
  background: #000;
  color: #f7f7f7;
}

.pet-main,
.section-head,
.sheet-actions,
.record,
.record-right {
  display: flex;
  align-items: center;
}

.pet-main,
.section-head,
.record {
  justify-content: space-between;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
}

.summary-head {
  margin-top: 10rpx;
}

.eyebrow {
  color: #8b8b92;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  margin-top: 16rpx;
  color: #fff;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.08;
}

.icon-btn {
  border-radius: 50%;
  background: #171719;
  color: #f7f7f7;
  font-size: 42rpx;
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx #242428;
}

.pet-tabs {
  margin: 42rpx -30rpx 30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.pet-tab {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  box-sizing: border-box;
  width: 304rpx;
  height: 104rpx;
  margin-right: 16rpx;
  padding: 14rpx 18rpx;
  border: 0;
  border-radius: 22rpx;
  background: #171719;
  color: #92929a;
  font-size: 28rpx;
  text-align: left;
  vertical-align: top;
}

.pet-tab.active {
  background: #242426;
  color: #fff;
  font-weight: 800;
  box-shadow: inset 0 0 0 2rpx #39393e;
}

.pet-tab-avatar {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #242426;
}

.pet-tab-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  line-height: 1.2;
}

.pet-tab-name {
  display: block;
  max-width: 180rpx;
  color: #f7f7f7;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-tab-type {
  display: block;
  margin-top: 6rpx;
  color: #8f8f97;
  font-size: 22rpx;
  font-weight: 800;
}

.pet-emoji,
.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #95ff17;
  color: #050505;
  font-weight: 900;
}

.pet-emoji {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.pet-panel,
.empty-panel {
  background: transparent;
}

.pet-main,
.empty-panel {
  border-radius: 16rpx;
  background: #1c1c1f;
  padding: 28rpx 30rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.03);
}

.pet-main-avatar {
  flex: 0 0 auto;
  width: 92rpx;
  height: 92rpx;
  margin-right: 18rpx;
  border-radius: 24rpx;
  background: #242426;
}

.pet-main > view {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.pet-name {
  color: #fff;
  font-size: 40rpx;
  font-weight: 900;
  text-align: left;
}

.pet-meta {
  margin-top: 10rpx;
  color: #8f8f97;
  font-size: 25rpx;
  text-align: left;
}

.ghost-btn,
.primary-btn,
.danger-btn {
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.ghost-btn {
  background: #2a2a2e;
  color: #f7f7f7;
}

.primary-btn {
  background: #95ff17;
  color: #050505;
}

.danger-btn {
  background: #3a1717;
  color: #ff7777;
}

.pet-delete-btn {
  width: 100%;
  margin-top: 22rpx;
}

.section {
  margin-top: 48rpx;
}

.first-section {
  margin-top: 0;
}

.tab-page {
  margin-top: 30rpx;
}

.quick-entry {
  cursor: pointer;
}

.section-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: left;
}

.section-head .section-title {
  text-align: left;
}

.stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.stat {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  min-height: 170rpx;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  background: #1c1c1f;
  text-align: left;
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.03);
}

.stat {
  justify-content: flex-start;
  min-height: 320rpx;
}

.stat-label {
  display: block;
  color: #919199;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
}

.stat-num {
  display: inline-block;
  color: #95ff17;
  font-size: 74rpx;
  font-weight: 900;
  line-height: 0.9;
}

.stat-value {
  display: flex;
  align-items: flex-end;
  margin-top: 22rpx;
  margin-bottom: 20rpx;
}

.stat-unit {
  display: inline-block;
  margin-left: 8rpx;
  color: #a7a7ae;
  font-size: 24rpx;
  font-weight: 700;
}

.tone-1 .stat-num {
  color: #ffd91a;
}

.tone-2 .stat-num {
  color: #ff9428;
}

.tone-3 .stat-num {
  color: #45d9ff;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  margin-top: 12rpx;
  color: #8f8f97;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.stat-row text:last-child {
  min-width: 0;
  color: #d7d7dc;
  text-align: right;
  word-break: break-all;
}

.stat.warn .stat-row:nth-of-type(3) text:last-child {
  color: #ff9428;
}

.stat.soon .stat-row:nth-of-type(3) text:last-child {
  color: #ffd91a;
}

.detail-btn {
  box-sizing: border-box;
  align-self: center;
  width: 100%;
  max-width: 220rpx;
  min-width: 0;
  height: 56rpx;
  padding: 0;
  margin-top: 22rpx;
  border-radius: 16rpx;
  background: #2d2416;
  color: #ffb454;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
  line-height: 56rpx;
}

@media (max-width: 340px) {
  .stats {
    grid-template-columns: 1fr;
  }

  .stat {
    min-height: 280rpx;
  }

  .detail-btn {
    max-width: 260rpx;
  }
}

.quick-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 148rpx;
  margin-top: 24rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #1c1c1f;
  color: #95ff17;
  font-size: 38rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.03);
}

.quick-choice-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.type-choice-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.type-choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  gap: 10rpx;
  border-radius: 16rpx;
  background: #242426;
  color: #9a9aa2;
  font-size: 24rpx;
  font-weight: 900;
}

.type-choice.selected {
  background: #95ff17;
  color: #050505;
}

.type-choice.selected .quick-icon {
  background: #050505;
  color: #95ff17;
}

.quick-choice {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  min-height: 116rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #1c1c1f;
  text-align: left;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.03);
}

.quick-icon {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.quick-title {
  margin-top: 18rpx;
  color: #f7f7f7;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.quick-choice .quick-title {
  margin-top: 0;
}

.quick-sub {
  margin-top: 8rpx;
  color: #898991;
  font-size: 22rpx;
  line-height: 1.35;
}

.reminders {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
}

.reminder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 82rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #1c1c1f;
  color: #d8d8dc;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
}

.reminder text {
  flex: 1;
}

.reminder.warn {
  color: #ff9428;
  background: #241b14;
}

.reminder.soon {
  color: #ffd91a;
  background: #211f12;
}

.record {
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #1c1c1f;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.03);
}

.record > view:first-child {
  flex: 1;
  text-align: left;
}

.record-title {
  color: #f7f7f7;
  font-size: 30rpx;
  font-weight: 900;
}

.record-note,
.record-right,
.empty,
.empty-text {
  color: #8d8d95;
  font-size: 24rpx;
}

.record-note {
  margin-top: 8rpx;
}

.record-right {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 158rpx;
  text-align: center;
}

.pet-list-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #1c1c1f;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.03);
}

.pet-list-item.active {
  box-shadow: inset 0 0 0 2rpx rgba(149, 255, 23, 0.45);
}

.pet-list-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #95ff17;
  color: #050505;
  font-size: 24rpx;
  font-weight: 900;
}

.pet-list-body {
  flex: 1;
  min-width: 0;
}

.pet-list-name {
  color: #fff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.pet-list-meta {
  margin-top: 8rpx;
  color: #8f8f97;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-all;
}

.delete-btn {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #3a2618;
  color: #ff9428;
  font-size: 22rpx;
  font-weight: 800;
}

.empty {
  margin-top: 20rpx;
  padding: 34rpx;
  border-radius: 16rpx;
  background: #1c1c1f;
  text-align: center;
}

.empty-panel {
  margin-top: 36rpx;
  text-align: center;
}

.empty-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
}

.empty-text {
  margin: 16rpx 0 26rpx;
  text-align: center;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.72);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  padding: 36rpx 30rpx calc(56rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #171719;
  box-shadow: 0 -20rpx 54rpx rgba(0, 0, 0, 0.5);
  overflow-y: auto;
}

@supports (bottom: constant(safe-area-inset-bottom)) {
  .sheet {
    padding-bottom: calc(56rpx + constant(safe-area-inset-bottom));
  }
}

.sheet-title {
  margin-bottom: 24rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  text-align: center;
}

.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: -4rpx auto 24rpx;
}

.avatar-preview {
  width: 142rpx;
  height: 142rpx;
  border-radius: 34rpx;
  background: #242426;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.08);
}

.avatar-picker-text {
  margin-top: 12rpx;
  color: #95ff17;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.drawer {
  padding-top: 18rpx;
}

.drawer-bar {
  width: 86rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #3a3a40;
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.drawer-head .sheet-title {
  flex: 1;
  margin-bottom: 0;
  text-align: left;
}

.input,
.picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 16rpx;
  background: #242426;
  color: #f7f7f7;
  font-size: 28rpx;
  text-align: center;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.3;
}

.form-label {
  margin: 8rpx 0 16rpx;
  color: #f7f7f7;
  font-size: 27rpx;
  font-weight: 900;
  text-align: center;
}

.interval-grid,
.profile-grid,
.segmented {
  display: grid;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.interval-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.profile-grid,
.segmented {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.interval-field,
.profile-field {
  color: #9a9aa2;
  font-size: 24rpx;
  text-align: center;
}

.interval-input,
.compact-picker,
.compact-input {
  min-height: 76rpx;
  margin: 8rpx 0 0;
  padding: 0 14rpx;
  font-size: 26rpx;
}

.due-preview {
  margin: -4rpx 0 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #162111;
  color: #95ff17;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.segmented button {
  height: 76rpx;
  border-radius: 16rpx;
  background: #242426;
  color: #9a9aa2;
  font-size: 28rpx;
  font-weight: 800;
}

.segmented button.selected {
  background: #95ff17;
  color: #050505;
}

.sheet-actions {
  justify-content: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.bottom-tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 14rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: rgba(23, 23, 25, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.45), inset 0 0 0 2rpx rgba(255, 255, 255, 0.06);
}

@supports (bottom: constant(safe-area-inset-bottom)) {
  .bottom-tabs {
    padding-bottom: calc(18rpx + constant(safe-area-inset-bottom));
  }
}

.bottom-tab {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 76rpx;
  padding: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #8f8f97;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.bottom-tab.active {
  background: #242426;
  color: #95ff17;
}

.bottom-tab text {
  display: block;
  width: 100%;
  text-align: center;
  white-space: nowrap;
}
