<view class="page">
  <view class="summary-head">
    <text class="eyebrow">{{currentDateText}}</text>
    <view class="title">{{activeTab === 'home' ? '照护摘要' : activeTab === 'records' ? '护理记录' : '宠物档案'}}</view>
  </view>

  <scroll-view wx:if="{{activeTab !== 'pets'}}" class="pet-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <block wx:for="{{displayPets}}" wx:key="id">
      <view class="pet-tab {{activePetId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectPet">
        <image class="pet-tab-avatar" src="{{item.avatarSrc}}" mode="aspectFill" />
        <view class="pet-tab-body">
          <text class="pet-tab-name">{{item.name}}</text>
          <text class="pet-tab-type">{{item.typeText}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <view wx:if="{{activeTab === 'home'}}">
    <view wx:if="{{activePet}}" class="pet-panel">
      <view class="pet-main">
        <image class="pet-main-avatar" src="{{activePet.avatarSrc}}" mode="aspectFill" />
        <view>
          <view class="pet-name">{{activePet.name}}</view>
          <view class="pet-meta">{{activePet.typeLabel}} · {{activePet.ageText}} · {{activePet.weightText}}</view>
        </view>
        <button class="ghost-btn" bindtap="showEditPetForm">编辑</button>
      </view>

      <view class="section quick-entry" bind:tap="showQuickDrawer">
        <view class="section-head">
          <view class="section-title">快捷记录</view>
        </view>
        <button class="quick-add-btn" hover-class="none" bind:tap="showQuickDrawer">+ 添加护理</button>
      </view>

      <view class="section">
        <view class="section-title">总体概览</view>
        <view class="stats">
          <view class="stat tone-{{item.tone}} {{item.nextStatus}}" wx:for="{{overviewItems}}" wx:key="type">
            <text class="stat-label">{{item.label}}</text>
            <view class="stat-value">
              <text class="stat-num">{{item.count}}</text>
              <text class="stat-unit">次</text>
            </view>
            <view class="stat-row">
              <text>上一次</text>
              <text>{{item.lastText}}</text>
            </view>
            <view class="stat-row">
              <text>距离下次</text>
              <text>{{item.nextText}}</text>
            </view>
            <button class="detail-btn" data-type="{{item.type}}" bindtap="showActionDetail">详情</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-panel">
      <view class="empty-title">先添加一个宠物</view>
      <view class="empty-text">支持猫和狗，可记录内驱虫、外驱虫、洗澡和遛狗。</view>
      <button class="primary-btn" bindtap="showAddPetForm">添加宠物</button>
    </view>
  </view>

  <view wx:if="{{activeTab === 'records'}}" class="tab-page">
    <view wx:if="{{activePet}}" class="section first-section">
      <view class="section-head">
        <view class="section-title">{{activePet.name}}的记录</view>
        <button class="ghost-btn" bindtap="showQuickDrawer">新增</button>
      </view>
      <view wx:if="{{displayRecords.length === 0}}" class="empty">还没有历史记录。</view>
      <block wx:for="{{displayRecords}}" wx:key="id">
        <view class="record">
          <view>
            <view class="record-title">{{item.label}} · {{item.dateText}}</view>
            <view class="record-note">{{item.note || '无备注'}}</view>
          </view>
          <view class="record-right">
            <button class="delete-btn" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="empty-panel">
      <view class="empty-title">暂无宠物</view>
      <view class="empty-text">添加宠物后可以记录护理历史。</view>
      <button class="primary-btn" bindtap="showAddPetForm">添加宠物</button>
    </view>
  </view>

  <view wx:if="{{activeTab === 'pets'}}" class="tab-page">
    <view class="section first-section">
      <view class="section-head">
        <view class="section-title">宠物档案</view>
        <button class="primary-btn" bindtap="showAddPetForm">添加</button>
      </view>
      <view wx:if="{{pets.length === 0}}" class="empty">还没有宠物档案。</view>
      <block wx:for="{{displayPets}}" wx:key="id">
        <view class="pet-list-item {{activePetId === item.id ? 'active' : ''}}">
          <image class="pet-list-avatar" src="{{item.avatarSrc}}" mode="aspectFill" />
          <view class="pet-list-body">
            <view class="pet-list-name">{{item.name}}</view>
            <view class="pet-list-meta">{{item.typeText}} · {{item.birthMonth}} · {{item.weightText}}</view>
          </view>
          <button class="ghost-btn" data-id="{{item.id}}" bindtap="editPetFromList">编辑</button>
        </view>
      </block>
    </view>
  </view>

  <view class="bottom-tabs">
    <view class="bottom-tab {{activeTab === 'home' ? 'active' : ''}}" data-tab="home" bindtap="setActiveTab">
      <text>首页</text>
    </view>
    <view class="bottom-tab {{activeTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="setActiveTab">
      <text>记录</text>
    </view>
    <view class="bottom-tab {{activeTab === 'pets' ? 'active' : ''}}" data-tab="pets" bindtap="setActiveTab">
      <text>宠物</text>
    </view>
  </view>

  <view wx:if="{{petFormVisible}}" class="mask">
    <view class="sheet">
      <view class="sheet-title">{{editingPetId ? '编辑宠物' : '添加宠物'}}</view>
      <view class="avatar-picker" bindtap="choosePetAvatar">
        <image class="avatar-preview" src="{{petFormAvatarSrc}}" mode="aspectFill" />
        <view class="avatar-picker-text">上传头像</view>
      </view>
      <input class="input" placeholder="宠物名字" value="{{petForm.name}}" data-field="name" bindinput="updatePetForm" />
      <view class="segmented">
        <button class="{{petForm.type === 'cat' ? 'selected' : ''}}" data-type="cat" bindtap="setPetType">猫</button>
        <button class="{{petForm.type === 'dog' ? 'selected' : ''}}" data-type="dog" bindtap="setPetType">狗</button>
      </view>
      <view class="profile-grid">
        <view class="profile-field">
          <text>出生年月</text>
          <picker mode="date" fields="month" value="{{petForm.birthMonth}}" end="{{birthMaxMonth}}" bindchange="setPetBirthMonth">
            <view class="picker compact-picker">{{petForm.birthMonth}}</view>
          </picker>
        </view>
        <view class="profile-field">
          <text>体重 kg</text>
          <input class="input compact-input" type="digit" placeholder="例如 4.5" value="{{petForm.weight}}" data-field="weight" bindinput="updatePetForm" />
        </view>
      </view>
      <view class="form-label">默认周期（天）</view>
      <view class="interval-grid">
        <view class="interval-field">
          <text>内驱</text>
          <input class="input interval-input" type="number" value="{{petForm.careIntervals.internalDeworm}}" data-field="internalDeworm" bindinput="updateCareInterval" />
        </view>
        <view class="interval-field">
          <text>外驱</text>
          <input class="input interval-input" type="number" value="{{petForm.careIntervals.externalDeworm}}" data-field="externalDeworm" bindinput="updateCareInterval" />
        </view>
        <view class="interval-field">
          <text>洗澡</text>
          <input class="input interval-input" type="number" value="{{petForm.careIntervals.bath}}" data-field="bath" bindinput="updateCareInterval" />
        </view>
      </view>
      <view class="sheet-actions">
        <button class="ghost-btn" bindtap="hidePetForm">取消</button>
        <button class="primary-btn" bindtap="savePet">保存</button>
      </view>
      <button wx:if="{{editingPetId}}" class="danger-btn pet-delete-btn" bindtap="deletePet">删除宠物</button>
    </view>
  </view>

  <view wx:if="{{recordFormVisible}}" class="mask">
    <view class="sheet drawer">
      <view class="drawer-bar"></view>
      <view class="sheet-title">添加记录</view>
      <view class="form-label">选择类型</view>
      <view class="type-choice-grid">
        <block wx:for="{{quickActions}}" wx:key="type">
          <view class="type-choice {{item.type === selectedRecordType ? 'selected' : ''}}" data-type="{{item.type}}" bind:tap="selectQuickAction">
            <text class="quick-icon">{{item.icon}}</text>
            <text>{{item.label}}</text>
          </view>
        </block>
      </view>
      <picker mode="date" value="{{recordDate}}" end="{{recordMaxDate}}" bindchange="setRecordDate">
        <view class="picker">上次时间：{{recordDate}}</view>
      </picker>
      <view wx:if="{{recordDuePreview}}" class="due-preview">{{recordDuePreview}}</view>
      <input class="input" placeholder="备注，可选" value="{{recordNote}}" bindinput="updateRecordNote" />
      <view class="sheet-actions">
        <button class="ghost-btn" bindtap="hideRecordForm">取消</button>
        <button class="primary-btn" bindtap="saveCustomRecord">确认</button>
      </view>
    </view>
  </view>

  <view wx:if="{{detailDrawerVisible}}" class="mask" bindtap="hideActionDetail">
    <view class="sheet drawer" catchtap="noop">
      <view class="drawer-bar"></view>
      <view class="drawer-head">
        <view class="sheet-title">{{detailActionLabel}}历史记录</view>
        <button class="ghost-btn" bindtap="hideActionDetail">关闭</button>
      </view>
      <view wx:if="{{detailRecords.length === 0}}" class="empty">还没有历史记录。</view>
      <block wx:for="{{detailRecords}}" wx:key="id">
        <view class="record">
          <view>
            <view class="record-title">{{item.dateText}}</view>
            <view class="record-note">{{item.note || '无备注'}}</view>
          </view>
          <view class="record-right">
            <button class="delete-btn" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
